NODE_ENV=development
PORT=3000
# Local development only. Leave this unset on any deployed server.
# The built-in development admin key is used only when all of these are true:
# NODE_ENV is development or test, this flag is true, ADMIN_API_KEY is unset or
# the local placeholder, and no hosting marker is present (VERCEL, RENDER,
# RAILWAY_ENVIRONMENT, FLY_APP_NAME, K_SERVICE, DYNO, HEROKU_APP_NAME,
# AWS_EXECUTION_ENV). Requests that use the development key are accepted only
# from loopback (127.0.0.1 or ::1). Ignored when NODE_ENV=production.
ALLOW_DEV_ADMIN_KEY=true
# Required in production. The server cannot prove this value is truly random.
# It only rejects a missing value, a value shorter than 32 characters, the local
# placeholder below, other known placeholders, and values with fewer than 4
# distinct characters. Generate a key and store it only in the host secret
# manager, never in git:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# The value below is the local placeholder. Do not deploy it.
# The same header protects /api/admin, /api/contacts, /api/workers,
# Telegram and LINE link-history, and the LINE rich-menu routes.
ADMIN_API_KEY=dev-admin-key

# Required in production (at least 32 characters). The server refuses to start
# without it. Generate a value and store it only in the host secret manager:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave this unset for local development. The process then creates an
# ephemeral secret, warns once, and does not keep sessions across restarts.
# Do not put a real secret in this file.
WEB_SESSION_SECRET=
# Optional previous secret used only to verify cookies during rotation.
# When set, it must also be at least 32 characters. Leave unset if unused.
WEB_SESSION_SECRET_PREVIOUS=

TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_MODE=polling
# Required only if TELEGRAM_BOT_MODE=webhook. Webhook delivery is not
# implemented; production and local startup both refuse webhook mode until
# this is at least 32 characters. Leave unset while mode is polling.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_POLLING_TIMEOUT_SECONDS=30
TELEGRAM_LINK_CODE_TTL_MINUTES=10

WHATSAPP_ENABLED=false
# Meta app secret. Placeholder only — never commit a real value.
# POST /api/whatsapp/webhook accepts an event only when the header
# X-Hub-Signature-256 is sha256=<hex> and that hex is HMAC-SHA256 of the
# original raw body using this secret. The digest is compared with
# crypto.timingSafeEqual after a length check. A missing or invalid signature
# returns HTTP 401 and is not processed. If this is empty, the POST fails
# closed with HTTP 503. WhatsApp is optional: the app still starts. Development
# and production log a startup warning only when WHATSAPP_ENABLED=true and this
# or WHATSAPP_VERIFY_TOKEN is missing. There is no unsigned development bypass.
WHATSAPP_APP_SECRET=
# Value you choose and enter in the Meta webhook form. Placeholder only.
# GET /api/whatsapp/webhook hashes hub.verify_token and this value with SHA-256
# and compares the digests with crypto.timingSafeEqual. hub.mode must be
# subscribe. A match returns hub.challenge as text/plain. A wrong, missing, or
# unconfigured token returns HTTP 403.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

LINE_ENABLED=false
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# AI cost guard (in-process, single-process pilot). Also set a hard monthly
# budget in the OpenAI dashboard; these counters reset on restart.
AI_ENABLED=true
AI_TIMEOUT_MS=20000
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=1000
# 0 = not enforced
AI_DAILY_TOKEN_LIMIT=0
# AI daily counters persistence (AI-06). Default <tmpdir>/gringo-ai-budget.json; "off" disables.
AI_BUDGET_STATE_FILE=

TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=
TRANSLATION_MODEL=
TRANSLATION_TIMEOUT_MS=30000
TRANSLATION_CACHE_ENABLED=true
TRANSLATION_CACHE_TTL_MINUTES=60

REFERENCE_EXCHANGE_RATE_API_ENDPOINT=
REFERENCE_EXCHANGE_RATE_TIMEOUT_MS=5000

CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_MAX_MESSAGES=20
CONTEXT_MANAGER_ENABLED=true
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_CHARACTERS=12000
CONVERSATION_SUMMARY_ENABLED=true
SUMMARY_TRIGGER_MESSAGES=20
SUMMARY_MAX_CHARACTERS=2500
MEMORY_IDLE_MINUTES=30
MEMORY_ARCHIVE_HOURS=24
MEMORY_CLEANUP_ENABLED=true

MULTI_AGENT_ENABLED=false
DEFAULT_AGENT_VERSION=1
SUPERVISOR_ENABLED=false
AGENT_EXECUTION_ENABLED=false
ACTIVE_SUPERVISOR_DELIVERY_ENABLED=true

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
