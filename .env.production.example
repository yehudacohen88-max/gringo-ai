# Gringo pilot — production settings TEMPLATE. NO REAL VALUES IN THIS FILE.
# On Render these are set by render.yaml + the Dashboard; this file is a
# reference only. Never commit a filled-in copy (.env and .env.production are git-ignored).

NODE_ENV=production
# PORT is provided by the host (Render sets it). Local default 3000.
TRUST_PROXY_HOPS=1

# Secrets (generate locally: openssl rand -base64 48)
ADMIN_API_KEY=
WEB_SESSION_SECRET=
# WEB_SESSION_SECRET_PREVIOUS=   # only while rotating

# Telegram — the only pilot channel
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
LINE_ENABLED=false
WHATSAPP_ENABLED=false

# Google Sheets — NEW pilot sheet + dedicated service account
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private_key value from the JSON key; "\n" escapes are accepted.
GOOGLE_SHEETS_PRIVATE_KEY=

# OpenAI — separate pilot project. In-app limits + kill switch are the PRIMARY guard;
# the OpenAI project budget is a backstop (enforcement is not instantaneous).
AI_PROVIDER=openai
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
AI_ENABLED=true
AI_TIMEOUT_MS=20000
AI_DAILY_USER_LIMIT=30
AI_DAILY_GLOBAL_LIMIT=300
AI_DAILY_TOKEN_LIMIT=300000
TRANSLATION_PROVIDER=

# Persistent disk (Render mount /var/data)
AI_BUDGET_STATE_FILE=/var/data/ai-budget.json
GRINGO_PROCESS_LOCK_FILE=/var/data/gringo.lock
TELEGRAM_STATE_FILE=/var/data/telegram-state.json
